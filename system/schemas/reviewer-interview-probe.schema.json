{
  "$defs": {
    "ProbeCurrentQuestion": {
      "additionalProperties": false,
      "description": "One question and the public cause that makes it available now.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "origin": {
          "enum": [
            "public-surface",
            "industry-standard",
            "candidate-answer"
          ],
          "title": "Origin",
          "type": "string"
        },
        "visible_basis": {
          "items": {
            "$ref": "#/$defs/ProbeVisibleBasis"
          },
          "minItems": 1,
          "title": "Visible Basis",
          "type": "array"
        }
      },
      "required": [
        "text",
        "origin",
        "visible_basis"
      ],
      "title": "ProbeCurrentQuestion",
      "type": "object"
    },
    "ProbeVisibleBasis": {
      "additionalProperties": false,
      "description": "One interviewer-visible atom supporting the current question.",
      "properties": {
        "source": {
          "enum": [
            "resume-claim",
            "jd",
            "candidate-answer"
          ],
          "title": "Source",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "source",
        "text"
      ],
      "title": "ProbeVisibleBasis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One active or closed branch returned by the Blind Interviewer.",
  "properties": {
    "schema": {
      "const": "resume-interview-probe/2",
      "title": "Schema",
      "type": "string"
    },
    "packet_status": {
      "enum": [
        "accepted",
        "rejected-leakage",
        "invalid"
      ],
      "title": "Packet Status",
      "type": "string"
    },
    "branch": {
      "minLength": 1,
      "title": "Branch",
      "type": "string"
    },
    "claim": {
      "minLength": 1,
      "title": "Claim",
      "type": "string"
    },
    "current_question": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProbeCurrentQuestion"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_dimensions": {
      "items": {
        "enum": [
          "fact-boundary",
          "technical-depth",
          "answer-structure",
          "tradeoff-resilience"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Target Dimensions",
      "type": "array"
    },
    "follow_up_triggers": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Follow Up Triggers",
      "type": "array"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "passed",
            "gap",
            "blocking-red-flag",
            "explicitly-skipped"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Outcome"
    }
  },
  "required": [
    "schema",
    "packet_status",
    "branch",
    "claim",
    "current_question",
    "target_dimensions",
    "follow_up_triggers",
    "outcome"
  ],
  "title": "Career OS Blind Interviewer Output",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-os.dev/schemas/reviewer-interview-probe.schema.json"
}
